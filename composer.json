{
  "name": "open774/p2-php",
  "description": "The server side 2ch viewer written in PHP",
  "license": "X11",
  "repositories": [
    {
      "type": "git",
      "url": "https://github.com/openpsa/quickform.git"
    },
    {
      "type": "git",
      "url": "https://github.com/roojs/PDO_DataObject.git"
    },
    {
      "type": "git",
      "url": "https://github.com/mikoim/html_template_flexy.git"
    },
    {
      "type": "git",
      "url": "https://github.com/mikoim/php8-File.git"
    },
    {
      "type": "git",
      "url": "https://github.com/pear/Benchmark.git"
    },
    {
      "type": "git",
      "url": "https://github.com/pear/Var_Dump.git"
    },
    {
      "type": "git",
      "url": "https://github.com/pear/XML_RSS.git"
    }
  ],
  "require": {
    "php": ">=8.2",
    "ext-curl": "*",
    "ext-dom": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-pcre": "*",
    "ext-pdo": "*",
    "ext-phar": "*",
    "ext-session": "*",
    "ext-spl": "*",
    "ext-xml": "*",
    "ext-zlib": "*",
    "jakeasmith/http_build_url": "1.0.*",
    "openpsa/quickform": "dev-master",
    "pear/benchmark": "dev-master",
    "pear/cache_lite": "1.*",
    "pear/http_request2": "^2.7",
    "pear/net_socket": "1.2.*",
    "pear/net_url2": "2.2.*",
    "nanasess/net_useragent_mobile": "1.0.*",
    "pear/pager": "2.5.*",
    "pear/validate": "0.8.*",
    "pear/var_dump": "dev-trunk",
    "pear/xml_parser": "1.3.*",
    "pear/xml_rss": "dev-master",
    "pear/file": "dev-master",
    "pear/html_template_flexy": "dev-master",
    "roojs/pdo_dataobject": "dev-master",
    "symfony/console": "7.4.*",
    "vectorface/whip": "0.5.*",
    "cweagans/composer-patches": "^2.0"
  },
  "config": {
    "platform": {
      "php": "8.2",
      "ext-gettext": "0"
    },
    "_comment": "ext-gettext: static PHPで不足しているため追加。使用している html_template_flexy では function_exists でガードしており不足していても問題無し",
    "allow-plugins": {
      "cweagans/composer-patches": true,
      "cweagans/composer-configurable-plugin": true
    }
  },
  "suggest": {
    "ext-exif": "Needed to show Exif in IC2",
    "ext-gd": "Needed to use GD in IC2",
    "ext-pdo_mysql": "Needed to use MySQL in IC2",
    "ext-pdo_pgsql": "Needed to use PostgreSQL in IC2",
    "ext-pdo_sqlite": "Needed to use SQLite in IC2"
  },
  "require-dev": {
    "roave/security-advisories": "dev-latest"
  },
  "autoload": {
    "exclude-from-classmap": ["vendor/pear/var_dump/docs/"]
  }
}
