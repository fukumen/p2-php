{
  "name": "open774/p2-php",
  "description": "The server side 2ch viewer written in PHP",
  "license": "X11",
  "repositories": [
    {
      "type": "git",
      "url": "https://github.com/openpsa/quickform.git"
    },
    {
      "type": "git",
      "url": "https://github.com/roojs/PDO_DataObject.git"
    },
    {
      "type": "git",
      "url": "https://github.com/mikoim/html_template_flexy.git"
    },
    {
      "type": "git",
      "url": "https://github.com/mikoim/php8-File.git"
    },
    {
      "type": "git",
      "url": "https://github.com/pear/Benchmark.git"
    },
    {
      "type": "package",
      "package": {
        "name": "pear/net_url",
        "version": "1.0.5",
        "type": "library",
        "source": {
          "type": "git",
          "url": "https://github.com/pear/Net_URL.git",
          "reference": "tags/RELEASE_1_0_5"
        },
        "target-dir": "Net",
        "autoload": {
          "classmap": ["Net/"]
        },
        "include-path": ["/"]
      }
    },
    {
      "type": "package",
      "package": {
        "name": "pear/net_useragent_mobile",
        "version": "1.0.0",
        "type": "library",
        "source": {
          "type": "git",
          "url": "https://github.com/pear/Net_UserAgent_Mobile.git",
          "reference": "tags/RELEASE_1_0_0"
        },
        "autoload": {
          "classmap": ["Net/"]
        },
        "include-path": ["/"]
      }
    },
    {
      "type": "git",
      "url": "https://github.com/pear/Var_Dump.git"
    },
    {
      "type": "git",
      "url": "https://github.com/pear/XML_RSS.git"
    }
  ],
  "require": {
    "php": ">7",
    "ext-curl": "*",
    "ext-dom": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-pcre": "*",
    "ext-pdo": "*",
    "ext-phar": "*",
    "ext-session": "*",
    "ext-spl": "*",
    "ext-xml": "*",
    "ext-zlib": "*",
    "jakeasmith/http_build_url": "1.0.*",
    "openpsa/quickform": "dev-master",
    "pear/benchmark": "dev-master",
    "pear/cache_lite": "1.*",
    "pear/http_request2": "^2.7",
    "pear/net_socket": "1.2.*",
    "pear/net_url": "1.0.*",
    "pear/net_url2": "2.2.*",
    "pear/net_useragent_mobile": "1.0.*",
    "pear/pager": "2.5.*",
    "pear/validate": "0.8.*",
    "pear/var_dump": "dev-trunk",
    "pear/xml_parser": "1.3.*",
    "pear/xml_rss": "dev-master",
    "pear/file": "dev-master",
    "pear/html_template_flexy": "dev-master",
    "roojs/pdo_dataobject": "dev-master",
    "symfony/console": "5.1.*",
    "symfony/yaml": "5.1.*"
  },
  "suggest": {
    "ext-exif": "Needed to show Exif in IC2",
    "ext-gd": "Needed to use GD in IC2",
    "ext-pdo_mysql": "Needed to use MySQL in IC2",
    "ext-pdo_pgsql": "Needed to use PostgreSQL in IC2",
    "ext-pdo_sqlite": "Needed to use SQLite in IC2"
  },
  "require-dev": {
    "roave/security-advisories": "dev-latest"
  }
}
