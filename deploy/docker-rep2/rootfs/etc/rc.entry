#!/bin/sh

export XDG_CONFIG_HOME="/ext/caddy_config"
export XDG_DATA_HOME="/ext/caddy_data"

mkdir -p "$XDG_CONFIG_HOME" "$XDG_DATA_HOME"

. /etc/rc.init

crond

if [ ! -f /etc/Caddyfile ]; then
cat <<EOF > /etc/Caddyfile
:8443 {
    log {
        output stderr
    }
EOF
if [ -n "$REP2_TLS_CERT" ] && [ -n "$REP2_TLS_KEY" ]; then
    echo "    tls $REP2_TLS_CERT $REP2_TLS_KEY" >> /etc/Caddyfile
fi
cat <<EOF >> /etc/Caddyfile
    root * /var/www/rep2
    php_fastcgi 127.0.0.1:9000
    file_server

    @js_files {
        path *.js
    }
    header @js_files Content-Type "application/javascript; charset=Shift_JIS"

    @css_files {
        path *.css
    }
    header @css_files Content-Type "text/css; charset=Shift_JIS"
}
EOF
fi

CADDY_USER=${CADDY_USER:-www-data}
sed -i "s/%%CADDY_USER%%/${CADDY_USER}/g" /etc/supervisord.conf

exec /usr/bin/supervisord -c /etc/supervisord.conf
